<script>
(() => {
  const COPY_LABEL = '复制';
  const OK_LABEL = '已复制';
  const FAIL_LABEL = '失败';

  function copyTextSync(text) {
    if (typeof text !== 'string') text = String(text ?? '');
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.cssText = 'position:fixed;top:0;left:0;width:2em;height:2em;padding:0;border:none;outline:none;opacity:0;';
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    textarea.setSelectionRange(0, textarea.value.length);
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch (e) {
      ok = false;
    }
    document.body.removeChild(textarea);
    return ok;
  }

  async function copyText(text) {
    if (copyTextSync(text)) return true;
    if (!navigator.clipboard || !navigator.clipboard.writeText) return false;
    try {
      await Promise.race([
        navigator.clipboard.writeText(text),
        new Promise((_, reject) => setTimeout(() => reject(new Error('clipboard-timeout')), 500))
      ]);
      return true;
    } catch (e) {
      return false;
    }
  }

  function extractCode(figure) {
    if (!figure) return '';
    const block = figure.matches('figure.highlight') ? figure : figure.closest('figure.highlight') || figure;
    const lines = block.querySelector('.code') || block.querySelector('code');
    if (!lines) return '';
    const lineNodes = lines.querySelectorAll('.line');
    if (lineNodes.length) {
      return Array.from(lineNodes).map(line => line.innerText.replace(/\n$/, '')).join('\n');
    }
    return lines.innerText;
  }

  function bindCopyButtons() {
    document.querySelectorAll('.copy-btn').forEach(btn => {
      if (btn.dataset.copyPatched === '1') return;
      const next = btn.cloneNode(false);
      next.className = btn.className;
      next.dataset.copyPatched = '1';
      next.textContent = COPY_LABEL;
      next.title = '复制代码';
      next.setAttribute('role', 'button');
      btn.replaceWith(next);

      next.addEventListener('click', async event => {
        event.preventDefault();
        event.stopPropagation();
        const figure = next.closest('figure.highlight') || next.closest('.code-container');
        const content = extractCode(figure);
        let ok = copyTextSync(content);
        if (!ok) ok = await copyText(content);
        next.textContent = ok ? OK_LABEL : FAIL_LABEL;
        next.classList.toggle('copied', ok);
        next.classList.toggle('copy-failed', !ok);
        setTimeout(() => {
          next.textContent = COPY_LABEL;
          next.classList.remove('copied', 'copy-failed');
        }, 1200);
      });
    });
  }

  function scheduleBind() {
    setTimeout(bindCopyButtons, 0);
  }

  document.addEventListener('DOMContentLoaded', scheduleBind);
  document.addEventListener('pjax:success', scheduleBind);
  document.addEventListener('page:loaded', scheduleBind);
})();
</script>
